# ============================================================
#  VORLAGE - kopiere diese Datei nach ".env" und fuelle sie aus
# ============================================================
# WICHTIG: Die echte Datei muss ".env" heissen (mit Punkt davor)
# und im selben Ordner wie quiz_agent.py liegen:
#   C:\Users\flori\quiz-agent\.env

# Dein Anthropic API-Schluessel (beginnt mit sk-ant-)
ANTHROPIC_API_KEY=sk-ant-HIER-DEINEN-SCHLUESSEL-EINFUEGEN

# Die Einladungs-URL zum Quiz
QUIZ_URL=https://usp-partner-ag.reteach.io/invitation?invitationToken=HIER-DEN-TOKEN-EINFUEGEN

# Deine Login-Daten fuer das Quiz
QUIZ_USERNAME=florianobfeuillet@gmail.com
QUIZ_PASSWORD=HIER-DEIN-PASSWORT-EINFUEGEN

# OPTIONAL: Nur setzen, wenn du einen ganz bestimmten Browser nutzen willst.
# Normalerweise LEER LASSEN - dann nimmt Playwright automatisch den richtigen Browser.
# CHROMIUM_PATH=C:\Users\flori\AppData\Local\ms-playwright\chromium-XXXX\chrome-win64\chrome.exe
